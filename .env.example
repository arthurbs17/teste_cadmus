NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
WORKER_PORT=3001

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=aggregation
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@localhost:${RABBITMQ_PORT}

SYNC_QUEUE=sync.consent
SYNC_PREFETCH=2
SYNC_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_DELAY_MS=5000
SYNC_RETRY_MAX_DELAY_MS=900000
SYNC_LEASE_TTL_MS=120000
SYNC_OVERLAP_DAYS=7
SYNC_INITIAL_LOOKBACK_DAYS=365

PARTNER_BASE_URL=
PARTNER_API_KEY=
PARTNER_TIMEOUT_MS=10000
PARTNER_PAGE_SIZE=500
